            <ImageView fx:id="monsterImage" fitHeight="150.0" fitWidth="200.0" layoutX="580.0" layoutY="24.0" opacity="0.0" pickOnBounds="true" preserveRatio="true" scaleX="1.5" scaleY="1.5">
