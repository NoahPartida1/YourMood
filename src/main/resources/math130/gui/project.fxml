<VBox alignment="CENTER" prefHeight="729.0" prefWidth="1634.0" spacing="20.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="math130.gui.YourMoodController">
