                </font>
            </Label>
            <TableView fx:id="stats" editable="true" layoutX="844.0" layoutY="-1.0" prefHeight="437.0" prefWidth="427.0">
                <columns>
                    <TableColumn prefWidth="202.00006103515625" text="Human" />
                    <TableColumn minWidth="0.0" prefWidth="223.33333333333331" text="Monster" />
