            <Circle fx:id="neutralCircle1" fill="#8d8d8d" layoutX="495.0" layoutY="131.0" opacity="0.0" radius="32.0" stroke="BLACK" strokeType="INSIDE" />
            <Label fx:id="monsterDamageTaken1" layoutX="405.0" layoutY="61.0" prefHeight="17.0" prefWidth="154.0" />
