                    <Font size="15.0" />
                </font>
            </TextArea>
            <Button fx:id="attack" layoutX="304.0" layoutY="377.0" mnemonicParsing="false" onAction="#clickedAttack" opacity="0.0" prefHeight="57.0" prefWidth="101.0" text="Attack" />
            <Circle fx:id="sadCircle" fill="DODGERBLUE" layoutX="561.0" layoutY="420.0" opacity="0.0" radius="32.0" stroke="BLACK" strokeType="INSIDE" />
            <Circle fx:id="angryCircle" fill="#e41414" layoutX="561.0" layoutY="420.0" opacity="0.0" radius="32.0" stroke="BLACK" strokeType="INSIDE" />
            <Circle fx:id="happyCircle" fill="#fff200" layoutX="561.0" layoutY="420.0" opacity="0.0" radius="32.0" stroke="BLACK" strokeType="INSIDE" />
